@startuml cas-utilisation
' Diagramme de cas d'utilisation — CoWork'In (atelier 1.3)
' Rendu : plantuml -tsvg cas-utilisation.puml
' Lecture : acteurs principaux en haut, frontière au centre (cinq paquets), acteurs secondaires (systèmes, temps) en bas.
top to bottom direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 18
skinparam ranksep 60
skinparam usecase {
  BackgroundColor #D8EBED
  BorderColor #0D6D77
}
skinparam rectangle {
  BorderColor #122029
}

' ---------- Acteurs principaux (toujours hors de la frontière) ----------
actor "Animateur d'atelier\n(A5)" as ANIM
actor "Référent société\n(A2)" as REF
actor "Coworker\n(A1)" as CW
actor "Hôte d'accueil\n(A3)" as HOTE
actor "Gérant\n(A4)" as GER

' Généralisations : le spécialisé pointe vers le général (même rangée)
REF -right-|> CW  : fait tout ce que fait\nun coworker, plus…
GER -left-|> HOTE : fait tout ce que fait\nun hôte, sur tous les sites

' ---------- Frontière du système ----------
rectangle "CoWork'In — plateforme de réservation" {

  package "Ateliers" {
    usecase "UC-11\nProposer un atelier" as UC11
    usecase "UC-12\nConsulter les inscrits\nde son atelier" as UC12
    usecase "UC-03\nS'inscrire à un atelier" as UC03
  }

  package "Compte" {
    usecase "UC-13\nCréer son compte" as UC13
    usecase "UC-14\nSuivre sa consommation\net ses factures" as UC14
    usecase "UC-10\nGérer les collaborateurs\nde sa société" as UC10
  }

  package "Réservation" {
    usecase "UC-01\nRéserver un poste" as UC01
    usecase "UC-02\nRéserver une salle\nde réunion" as UC02
    usecase "UC-04\nAnnuler une réservation" as UC04
    usecase "UC-05\nConsulter les\ndisponibilités" as UC05
    usecase "UC-15\nRégler un montant dû" as UC15
  }

  package "Exploitation du site" {
    usecase "UC-07\nMettre un espace\nen maintenance" as UC07
    usecase "UC-06\nConsulter les présents\nd'un site" as UC06
    usecase "UC-09\nSuivre le taux\nd'occupation" as UC09
  }

  package "Facturation" {
    usecase "UC-08\nÉditer les factures\nmensuelles" as UC08
  }
}

' ---------- Acteurs secondaires (en bas) ----------
actor "Service d'e-mailing\n(A7) <<system>>" as MAIL
actor "Prestataire de paiement\n(A6) <<system>>" as PSP
actor "Planificateur\n(A8) <<temps>>" as CLOCK

' ---------- Associations acteur principal — cas d'usage ----------
ANIM -- UC11
ANIM -- UC12

CW -- UC03
CW -- UC13
CW -- UC14
CW -- UC01
CW -- UC02
CW -- UC04

REF -- UC10

HOTE -- UC01
HOTE -- UC02
HOTE -- UC04
HOTE -- UC07
HOTE -- UC06

GER -- UC09
GER -- UC08

' ---------- Relations entre cas d'usage (3 à 5 maximum) ----------
' include : la base pointe vers l'inclus — on ne peut pas réserver sans consulter
UC01 ..> UC05 : <<include>>
UC02 ..> UC05 : <<include>>
' extend : l'extension pointe vers la base — la base est complète sans elle
UC15 .up.> UC01 : <<extend>>\n[montant dû > 0]
UC15 .up.> UC02 : <<extend>>\n[montant dû > 0]

' ---------- Acteurs secondaires : sollicités par le système ----------
UC15 -down- PSP
UC05 -[hidden]down- MAIL
UC05 -[hidden]down- CLOCK
MAIL -[hidden]right- PSP
PSP -[hidden]right- CLOCK
UC04 -down- PSP : remboursement
UC01 -down- MAIL
UC02 -down- MAIL
UC03 -down- MAIL
UC04 -down- MAIL
UC08 -down- MAIL
UC08 -down- CLOCK : déclenche le 1er du mois

legend bottom
  Pas de cas « S'authentifier » : c'est une précondition de chaque fiche, pas un objectif métier.
  Le service d'e-mailing est relié aux cinq cas qui se terminent par un envoi plutôt que par un
  « Notifier » inclus partout (voir cas-utilisation.md, section 2).
endlegend

@enduml
